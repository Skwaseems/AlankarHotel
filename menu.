        </div>

        <div class="menu-container">
            <div id="menuItemsDisplay"></div>
        </div>
    </div>

    <!-- ADMIN PANEL VIEW -->
    <div class="admin-panel" id="adminPanel">
        <div class="admin-header">
            <h1>🍽️ Restaurant Menu Management System</h1>
            <p>Manage your menu items, rates, and restaurant information</p>
        </div>

        <div class="admin-container">
            <div class="admin-tabs">
                <button class="tab-btn active" data-tab="restaurant">Restaurant Settings</button>
                <button class="tab-btn" data-tab="menu">Menu Items</button>
                <button class="tab-btn" data-tab="qrcode">QR Code & Link</button>
            </div>

            <!-- Restaurant Settings Tab -->
            <div class="tab-content active" id="restaurantTab">
                <div class="settings-form">
                    <h2 class="form-section-title">Restaurant Information</h2>
                    <div class="success-message" id="settingsMessage"></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="restaurantName">Restaurant Name</label>
                            <input type="text" id="restaurantName" placeholder="e.g., Alankar Restaurant">
                        </div>
                        <div class="form-group">
                            <label for="contactPhone">Contact Phone Number</label>
                            <input type="tel" id="contactPhone" placeholder="e.g., +91 9404790786">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="restaurantTimings">Timings</label>
                        <input type="text" id="restaurantTimings" placeholder="e.g., 09:00 AM - 11:30 AM (Breakfast) | 11:30 AM - 11:00 PM">
                    </div>

                    <div class="form-group">
                        <label for="restaurantAddress">Address</label>
                        <textarea id="restaurantAddress" placeholder="Full address..." rows="3"></textarea>
                    </div>

                    <div class="button-group">
                        <button class="btn btn-primary" onclick="saveRestaurantSettings()">Save Settings</button>
                        <button class="btn btn-secondary" onclick="resetSettingsForm()">Reset</button>
                    </div>
                </div>
            </div>

            <!-- Menu Items Tab -->
            <div class="tab-content" id="menuTab">
                <div class="menu-form">
                    <h2 class="form-section-title">Add New Menu Item</h2>
                    <div class="success-message" id="itemMessage"></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="itemCategory">Category</label>
                            <input type="text" id="itemCategory" placeholder="e.g., Breakfast, Chicken, Chinese Rice, etc.">
                        </div>
                        <div class="form-group">
                            <label for="itemName">Item Name</label>
                            <input type="text" id="itemName" placeholder="e.g., Alankar Special Chicken/Mutton">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="itemRate">Rate/Price</label>
                            <input type="text" id="itemRate" placeholder="e.g., 400/450 or just 250">
                        </div>
                        <div class="form-group">
                            <label for="itemDescription">Description (Optional)</label>
                            <input type="text" id="itemDescription" placeholder="e.g., Spicy and delicious...">
                        </div>
                    </div>

                    <div class="button-group">
                        <button class="btn btn-success" onclick="addMenuItem()">Add Item</button>
                        <button class="btn btn-secondary" onclick="resetMenuForm()">Clear Form</button>
                    </div>
                </div>

                <h2 class="form-section-title" style="margin-top: 30px;">Menu Items</h2>
                <div class="menu-items-container" id="menuItemsList">
                    <div class="empty-message">No menu items added yet. Add one to get started!</div>
                </div>
            </div>

            <!-- QR Code Tab -->
            <div class="tab-content" id="qrcodeTab">
                <div class="qr-section">
                    <h3>📱 Menu Access Link & QR Code</h3>
                    <p style="color: #666; margin-bottom: 20px;">Customers can scan this QR code or use the link below to view your menu</p>

                    <div id="qrcode"></div>

                    <div class="qr-url" id="menuLink">
                        Generate QR Code...
                    </div>

                    <div class="qr-buttons">
                        <button class="btn btn-primary" onclick="generateQRCode()">Regenerate QR Code</button>
                        <button class="btn btn-secondary" onclick="copyToClipboard()">Copy Link</button>
                        <button class="btn btn-secondary" onclick="downloadQRCode()">Download QR Code</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="scroll-top" id="scrollTop" onclick="scrollToTop()">↑</div>

